{
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "rewrites": [
    {
      "source": "/((?!api/|icons/|manifest\\.webmanifest|sw\\.js|workbox-.*|assets/).*)",
      "destination": "/index.html"
    },
    {
      "source": "/api/webhook-basics",
      "destination": "/api/webhook-asaas"
    },
    {
      "source": "/api/create-subscription",
      "destination": "/api/subscriptions?__action=create"
    },
    {
      "source": "/api/subscription-status",
      "destination": "/api/subscriptions?__action=status"
    },
    {
      "source": "/api/subscription-history",
      "destination": "/api/subscriptions?__action=history"
    },
    {
      "source": "/api/materials",
      "destination": "/api/content?__resource=materials"
    },
    {
      "source": "/api/briefs",
      "destination": "/api/content?__resource=briefs"
    },
    {
      "source": "/api/leaderboard-recover",
      "destination": "/api/leaderboard?__action=recover"
    },
    {
      "source": "/api/email-test",
      "destination": "/api/admin-diagnostics?__action=email-test"
    },
    {
      "source": "/api/email-reset",
      "destination": "/api/admin-diagnostics?__action=email-reset"
    },
    {
      "source": "/api/campaign-dry-run",
      "destination": "/api/admin-diagnostics?__action=campaign-dry-run"
    },
    {
      "source": "/api/flash-lite-test",
      "destination": "/api/admin-diagnostics?__action=flash-test"
    }
  ]
}
